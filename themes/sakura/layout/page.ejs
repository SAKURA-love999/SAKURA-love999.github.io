<article class="post-sheet">
  <header class="post-header">
    <h1 class="post-heading" <% if (page.title_ja && page.title_zh) { %>data-ja="<%= page.title_ja %>" data-zh="<%= page.title_zh %>"<% } %>><%= page.title %></h1>
  </header>
  <div class="post-content" lang="<%= page.lang || 'ja' %>"><%- page.content %></div>
</article>
