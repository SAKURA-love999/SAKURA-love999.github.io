<article class="post-sheet">
  <header class="post-header">
    <p class="post-date"><time datetime="<%= date(page.date, 'YYYY-MM-DD') %>"><%= date(page.date, 'YYYY年MM月DD日') %></time></p>
    <h1 class="post-heading"><%= page.title %></h1>
    <% if (page.categories.length || page.tags.length) { %>
    <div class="post-taxonomies">
      <% page.categories.each(function(category) { %><a href="<%- url_for(category.path) %>"><%= category.name %></a><% }); %>
      <% page.tags.each(function(tag) { %><a href="<%- url_for(tag.path) %>">#<%= tag.name %></a><% }); %>
    </div>
    <% } %>
  </header>
  <img class="post-cover" src="<%= sakura_cover(page) %>" alt="">
  <div class="post-content" lang="<%= page.lang || 'ja' %>"><%- page.content %></div>
</article>
<nav class="post-neighbors" aria-label="Articles">
  <% if (page.prev) { %><a rel="prev" href="<%- url_for(page.prev.path) %>">← <%= page.prev.title %></a><% } %>
  <% if (page.next) { %><a rel="next" href="<%- url_for(page.next.path) %>"><%= page.next.title %> →</a><% } %>
</nav>
<a class="return-link" href="<%- url_for('/log/') %>" data-ja="日記に戻る" data-zh="返回日志">日記に戻る</a>
